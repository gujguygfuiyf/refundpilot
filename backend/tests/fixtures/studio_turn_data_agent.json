 "instructions": "You are the data agent of a dashboard assistant. Read the schema, run queries to answer the task you were given, and hand the result back with complete_task.",
 "tools": [
  {
   "name": "execute_query",
   "kind": "client",
   "description": "Run a query against the dashboard's data: group by dimensions and aggregate measures, or return rows.",
   "parameters": {
    "type": "object",
    "properties": {
     "query": {
      "type": "object",
      "properties": {
       "dimensions": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/FieldRef"
        }
       },
       "measures": {
        "type": "array",
        "items": {
         "anyOf": [
          {
           "type": "object",
           "properties": {
            "field": {
             "$ref": "#/$defs/FieldRef"
            },
            "as": {
             "type": "string"
            }
           },
           "required": [
            "field"
           ],
           "additionalProperties": false
          },
          {
           "type": "object",
           "properties": {
            "expression": {
             "$ref": "#/$defs/Expression"
            },
            "as": {
             "type": "string"
            }
           },
           "required": [
            "expression",
            "as"
           ],
           "additionalProperties": false
          }
         ]
        }
       },
       "filter": {
        "$ref": "#/$defs/Filter"
       },
       "limit": {
        "type": "number"
       }
      },
      "required": [
       "measures"
      ],
      "additionalProperties": false
     }
    },
    "required": [
     "query"
    ],
    "additionalProperties": false,
    "$defs": {
     "FieldRef": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string",
        "enum": [
         "runs.run",
         "runs.group",
         "runs.overpaid",
         "runs.suggested"
        ]
       },
       "aggregation": {
        "anyOf": [
         {
          "type": "string",
          "enum": [
           "sum",
           "avg",
           "count"
          ]
         },
         {
          "not": {}
         }
        ]
       }
      },
      "required": [
       "id"
      ],
      "additionalProperties": false
     },
     "Expression": {
      "anyOf": [
       {
        "type": "object",
        "properties": {
         "literal": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "number"
           },
           {
            "type": "boolean"
           },
           {
            "type": "string",
            "format": "date-time"
           }
          ]
         }
        },
        "required": [
         "literal"
        ],
        "additionalProperties": false
       },
       {
        "type": "object",
        "properties": {
         "operator": {
          "type": "string",
          "enum": [
           "add",
           "subtract",
           "multiply",
           "divide"
          ]
         },
         "inputs": {
          "type": "array",
          "items": {
           "$ref": "#/$defs/Expression"
          },
          "minItems": 2
         }
        },
        "required": [
         "operator",
         "inputs"
        ],
        "additionalProperties": false
       },
       {
        "type": "object",
        "properties": {
         "field": {
          "$ref": "#/$defs/FieldRef"
         }
        },
        "required": [
         "field"
        ],
        "additionalProperties": false
       }
      ]
     },
     "Filter": {
      "anyOf": [
       {
        "type": "object",
        "properties": {
         "field": {
          "$ref": "#/$defs/FieldRef"
         },
         "operator": {
          "type": "string",
          "enum": [
           "equals",
           "isIn",
           "greaterThan"
          ]
         },
         "value": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "number"
           },
           {
            "type": "array",
            "items": {
             "anyOf": [
              {
               "type": "string"
              },
              {
               "type": "number"
              },
              {
               "type": "null"
              }
             ]
            }
           }
          ]
         }
        },
        "required": [
         "field",
         "operator",
         "value"
        ],
        "additionalProperties": false
       },
       {
        "$ref": "#/$defs/FilterGroup"
       }
      ]
     },
     "FilterGroup": {
      "type": "object",
      "properties": {
       "operator": {
        "type": "string",
        "enum": [
         "and",
         "or"
        ]
       },
       "filters": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/Filter"
        }
       }
      },
      "required": [
       "operator",
       "filters"
      ],
      "additionalProperties": false
     }
    }
   }
  },
  {
   "name": "view_schema",
