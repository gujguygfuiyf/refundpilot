      "type": "string",
      "description": "What was found or done. It goes back to the agent that asked."
     },
     "artifacts": {
      "type": "array",
      "description": "Things created by tool calls. [] if none.",
      "items": {
       "type": "object",
       "properties": {
        "id": {
         "type": "string"
        },
        "type": {
         "type": "string"
        },
        "description": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "type",
        "description"
       ],
       "additionalProperties": false
      }
     }
    },
    "required": [
     "summary",
     "artifacts"
    ],
    "additionalProperties": false
   }
  }
 ],
