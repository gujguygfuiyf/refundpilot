# PayPal sandbox app (Developer Dashboard -> Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook ID after you register https://<api-host>/webhooks/paypal for PAYMENT.CAPTURE.REFUNDED
PAYPAL_WEBHOOK_ID=

# AI. Gemini is the primary provider (aistudio.google.com -> Get API key). OpenAI is an optional backup:
# if OPENAI_API_KEY is set it is tried when Gemini fails. AI_PROVIDER=openai puts OpenAI first instead.
# No keys at all = a canned offline assessor.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Storage and auth. change-me is fine locally; a deployed API refuses to start with it.
DATABASE_URL=sqlite:///./data/refundpilot.db
MERCHANT_TOKEN=change-me
DEV_TOKEN=change-me
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=5

# Public-demo guards: claim submissions per IP per minute, and AI assessments per UTC day (0 = off)
CLAIMS_PER_IP_PER_MINUTE=5
AI_CALLS_PER_DAY=200
# Keep unclaimed sandbox orders "delivered 3 days ago" so the policy window never expires during judging
DEMO_ROLLING_DELIVERY=true
DISPUTES_ENABLED=true

# Insights assistant (AG Studio's agents on /merchant/insights; one Gemini turn per POST /merchant/assistant/turn).
# Off without a Gemini key. ASSISTANT_API_KEY and ASSISTANT_MODEL default to GEMINI_API_KEY and GEMINI_MODEL; a
# separate key keeps the assistant's quota apart from claim assessments. One question takes several turns.
ASSISTANT_ENABLED=true
ASSISTANT_API_KEY=
ASSISTANT_MODEL=
# Public-demo guards: turns per UTC day (counted in the database) and per IP per minute (0 = no limit)
ASSISTANT_TURNS_PER_DAY=300
ASSISTANT_TURNS_PER_IP_PER_MINUTE=40
# Output token cap per model call, and Gemini's thinking level (empty = the model's default)
ASSISTANT_MAX_OUTPUT_TOKENS=16384
ASSISTANT_THINKING_LEVEL=
