# PayPal sandbox app (Developer Dashboard -> Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook ID after you register https://<api-host>/webhooks/paypal for PAYMENT.CAPTURE.REFUNDED
PAYPAL_WEBHOOK_ID=

# AI providers. Primary: OpenAI (GPT vision). Backup: Gemini. AI_PROVIDER=openai|gemini|auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER=auto

# Storage and auth
DATABASE_URL=sqlite:///./data/refundpilot.db
MERCHANT_TOKEN=change-me
DEV_TOKEN=change-me
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=5
