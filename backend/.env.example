# PayPal sandbox app (Developer Dashboard -> Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook ID after you register https://<api-host>/webhooks/paypal for PAYMENT.CAPTURE.REFUNDED
PAYPAL_WEBHOOK_ID=

# AI providers. Current choice: Gemini only (AI_PROVIDER=gemini). auto = OpenAI first, Gemini on failure. AI_PROVIDER=openai|gemini|auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AI_PROVIDER=gemini

# Storage and auth
DATABASE_URL=sqlite:///./data/refundpilot.db
MERCHANT_TOKEN=change-me
DEV_TOKEN=change-me
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=5
