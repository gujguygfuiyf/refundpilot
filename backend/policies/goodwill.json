{
  "version": "goodwill-1.0",
  "name": "Goodwill",
  "report_window_days": 30,
  "auto_approve_below_cents": 0,
  "max_partial_percent": 60,
  "strict_human_review": false,
  "rules": [
    {"id": "R1-broken", "when": {"product_match": ["confirmed", "likely", "cannot_tell"], "damage_type": ["broken", "shattered", "missing_part"], "evidence_quality": ["sufficient", "unclear"]}, "outcome": "FULL_REFUND", "reason": "Broken on arrival; refund in full to keep the customer"},
    {"id": "R2-cosmetic", "when": {"damage_type": ["cosmetic"]}, "outcome": "PARTIAL_REFUND", "percent": 50, "reason": "Cosmetic damage; generous partial refund"},
    {"id": "R3-wrong", "when": {"damage_type": ["wrong_item", "not_as_described"]}, "outcome": "FULL_REFUND", "reason": "Wrong item; refund and let the customer keep it"},
    {"id": "R4-mismatch", "when": {"product_match": ["mismatch"]}, "outcome": "REQUEST_EVIDENCE", "reason": "Photos clearly show a different product"},
    {"id": "R5-weak", "when": {"evidence_quality": ["insufficient"]}, "outcome": "REQUEST_EVIDENCE", "reason": "Need a clearer photo"}
  ],
  "default_outcome": "REVIEW",
  "out_of_window_outcome": "REVIEW",
  "repeat_claim_outcome": "REVIEW"
}
