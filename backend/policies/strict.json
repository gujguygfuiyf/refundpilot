{
  "version": "strict-1.1",
  "name": "Strict",
  "report_window_days": 7,
  "auto_approve_below_cents": 0,
  "max_partial_percent": 25,
  "strict_human_review": true,
  "rules": [
    {"id": "R6-stock", "when": {"stock_photo_suspected": true}, "outcome": "REJECT", "reason": "Photo may be a stock image or a screenshot, not the buyer's own photo"},
    {"id": "R1-broken", "when": {"product_match": ["confirmed"], "damage_type": ["broken", "shattered", "missing_part"], "evidence_quality": ["sufficient"], "stock_photo_suspected": false}, "outcome": "FULL_REFUND", "reason": "Confirmed product, clearly broken"},
    {"id": "R1b-likely", "when": {"product_match": ["likely"], "damage_type": ["broken", "shattered", "missing_part"], "evidence_quality": ["sufficient"]}, "outcome": "REVIEW", "reason": "Product match only likely; merchant confirms"},
    {"id": "R2-cosmetic", "when": {"product_match": ["confirmed", "likely"], "damage_type": ["cosmetic"], "evidence_quality": ["sufficient"]}, "outcome": "PARTIAL_REFUND", "percent": 15, "reason": "Cosmetic damage; small goodwill refund"},
    {"id": "R4-mismatch", "when": {"product_match": ["unlikely", "mismatch"]}, "outcome": "REJECT", "reason": "Photos do not show the ordered product"},
    {"id": "R5-weak", "when": {"evidence_quality": ["insufficient", "unclear"]}, "outcome": "REQUEST_EVIDENCE", "reason": "Photos are not clear enough"}
  ],
  "default_outcome": "REVIEW",
  "out_of_window_outcome": "REJECT",
  "repeat_claim_outcome": "REJECT"
}
