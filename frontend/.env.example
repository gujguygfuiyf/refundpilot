# Backend URL (FastAPI). Local default shown.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Optional: prefill the merchant token for the public demo so judges skip the sign-in step.
NEXT_PUBLIC_DEMO_MERCHANT_TOKEN=
# Optional: AG Studio licence key for the Insights page. Read at build time; without it Studio shows a watermark.
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=
